/*
 * Device Tree Overlay for HH983 FPDLink Serializer
 *
 * Usage: Add to /boot/config.txt:
 *   dtoverlay=hh983-serializer
 *
 * Optional parameters:
 *   dtoverlay=hh983-serializer,addr=0x18
 *
 * The driver mode is controlled via module parameter, not from the overlay:
 *   /etc/modprobe.d/hh983.conf: options hh983-serializer config_mode=<0|1|2>
 *     0 = 983 + 984  (REM_INTB forwarding)
 *     1 = 983 + 988  (TDDI touch via I2C pass-through + REM_INTB)
 *     2 = 983 + 988  video only, no touch (3x QVue); pass-through only, so the
 *         983 target slots the RH850 used to alias the 988 are left alone
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2711";

	/* Define configurable parameters */
	fragment@0 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			hh983: serializer@18 {
				compatible = "ti,hh983-serializer";
				reg = <0x18>;
				status = "okay";
			};
		};
	};

	/* Allow address override via dtoverlay parameter */
	__overrides__ {
		addr = <&hh983>,"reg:0";
	};
};
