#!/bin/sh
# fake-net-ctl - net-ctl.sh's stand-in for the UI: canned answers from a
# scenario, no NetworkManager, no root, no network.
#
#   FAKE_NET_SCENARIO  online-serving (default) | offline | usb-adapter | no-nm |
#                      wifi-blocked | wifi-absent | wifi-default | dead-uplink |
#                      connect-ok | connect-bad-password | connect-not-found |
#                      connect-no-address | connect-timeout |
#                      wired-static | probe-found | probe-none | probe-no-cable |
#                      legacy-server | wired-fail | guard-stopped | guard-checking |
#                      reserved (online-serving with two reserved clients: one with
#                      its lease, one away) | reserve-fail (dhcp-reserve refuses)
#   FAKE_NET_STEP      seconds between PROGRESS lines of a change (default 0.4)
#   FAKE_TOOL          the Tools' outcome: ok (default) | loss | no-reply | unknown-host
#                      (ping) · dns-fail | gateway-fail | captive | tls (internet-check)
#                      · refused | unreachable | port-busy (iperf) · busy (iperf server
#                      with a client, then waits)
#   FAKE_TOOL_STEP     seconds between a tool's lines (default 0.15)
#
# Values are percent-encoded as net-ctl.sh encodes them. The app runs this
# script without sudo in a dry run, and fake-net-ctl ignores --dry-run: the
# point is to see every outcome on screen.
scenario=${FAKE_NET_SCENARIO:-online-serving}
step=${FAKE_NET_STEP:-0.4}
cmd=${1:-}

if [ "$scenario" = no-nm ]; then
    case $cmd in
        available) echo "RESULT kind=available ok=0 reason=nmcli is not installed"; exit 4 ;;
        *) echo "RESULT kind=error ok=0 detail=nmcli%20is%20not%20installed reason=no-nm"; exit 4 ;;
    esac
fi

# The fields after the round-two additions; "cfg" is the profile that is (or
# would be) active on the port
cfg() { # <profile uuid> <profile name> <saved> <binding> <ip> <prefix> <gateway> <dns>
    printf 'profileuuid=%s cfgprofile=%s saved=%s binding=%s cfgip=%s cfgprefix=%s cfggateway=%s cfgdns=%s' "$@"
}
W1=$(cfg 6a787e8b-9525-3f87-acef-5559ddfc8258 Wired%20connection%201 0 name '' '' '' '')
W2=$(cfg f3d397f2-484d-3505-97c2-d373aede5a20 Wired%20connection%202 0 name '' '' '' '')

eth0_up="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=1 speed=1000 state=connected profile=Wired%20connection%201 mode=client ip=192.168.1.170 prefix=24 gateway=192.168.1.1 dns=192.168.1.1 ssid= signal= band= default=1 driver=bcmgenet product= ip6=fdac:d87e:4f12::538/128,fe80::76f9:b550:2848:fea0/64 dhcpserver=192.168.1.1 leasetime=86400 leaseexpiry= inet=yes $W1"
eth0_up2="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=1 speed=1000 state=connected profile=Wired%20connection%201 mode=client ip=192.168.1.170 prefix=24 gateway=192.168.1.1 dns=192.168.1.1 ssid= signal= band= default=0 driver=bcmgenet product= ip6=fe80::76f9:b550:2848:fea0/64 dhcpserver=192.168.1.1 leasetime=86400 leaseexpiry= inet=yes $W1"
eth0_nocable="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=0 speed= state=unavailable profile= mode=client ip= prefix= gateway= dns= ssid= signal= band= default=0 driver=bcmgenet product= ip6= dhcpserver= leasetime= leaseexpiry= inet= $W1"
eth0_lan="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=1 speed=1000 state=connected profile=Wired%20connection%201 mode=client ip=192.168.1.170 prefix=24 gateway=192.168.1.1 dns=192.168.1.1 ssid= signal= band= default=0 driver=bcmgenet product= ip6=fe80::76f9:b550:2848:fea0/64 dhcpserver=192.168.1.1 leasetime=86400 leaseexpiry= inet=no $W1"
eth0_static="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=1 speed=1000 state=connected profile=eth0 mode=static ip=192.168.1.170 prefix=24 gateway=192.168.1.1 dns=192.168.1.1 ssid= signal= band= default=1 driver=bcmgenet product= ip6=fe80::76f9:b550:2848:fea0/64 dhcpserver= leasetime= leaseexpiry= inet=yes $(cfg 0d1e2f30-0000-4000-8000-000000000001 eth0 1 name 192.168.1.170 24 192.168.1.1 192.168.1.1)"
eth0_legacy="RESULT kind=iface name=eth0 type=ethernet usb=0 mac=2C:CF:67:4F:66:CA carrier=1 speed=1000 state=connected profile=eth0 mode=legacy-server ip=192.168.60.1 prefix=24 gateway= dns= ssid= signal= band= default=0 driver=bcmgenet product= ip6= dhcpserver= leasetime= leaseexpiry= inet= $(cfg 0d1e2f30-0000-4000-8000-000000000001 eth0 1 name 192.168.60.1 24 '' '')"
wlan_on='RESULT kind=iface name=wlan0 type=wifi usb=0 mac=2C:CF:67:4F:66:CB carrier=1 speed= state=connected profile=Workshop mode=client ip=192.168.20.138 prefix=24 gateway=192.168.20.1 dns=192.168.20.1 ssid=Workshop signal=71 band=5 default=0 driver=brcmfmac product= ip6=fe80::4eef:9377:8662:a1bc/64 dhcpserver=192.168.20.1 leasetime=43200 leaseexpiry= inet=yes'
wlan_default='RESULT kind=iface name=wlan0 type=wifi usb=0 mac=2C:CF:67:4F:66:CB carrier=1 speed= state=connected profile=Workshop mode=client ip=192.168.20.138 prefix=24 gateway=192.168.20.1 dns=192.168.20.1 ssid=Workshop signal=71 band=5 default=1 driver=brcmfmac product= ip6=fe80::4eef:9377:8662:a1bc/64 dhcpserver=192.168.20.1 leasetime=43200 leaseexpiry= inet=yes'
wlan_idle='RESULT kind=iface name=wlan0 type=wifi usb=0 mac=2C:CF:67:4F:66:CB carrier=0 speed= state=disconnected profile= mode=off ip= prefix= gateway= dns= ssid= signal= band= default=0 driver=brcmfmac product= ip6= dhcpserver= leasetime= leaseexpiry= inet='
wlan_off='RESULT kind=iface name=wlan0 type=wifi usb=0 mac=2C:CF:67:4F:66:CB carrier=0 speed= state=unavailable profile= mode=off ip= prefix= gateway= dns= ssid= signal= band= default=0 driver=brcmfmac product= ip6= dhcpserver= leasetime= leaseexpiry= inet='
eth1_serving="RESULT kind=iface name=eth1 type=ethernet usb=1 mac=00:0E:C6:A1:B2:C3 carrier=1 speed=100 state=connected profile=USB%20adapter%2000:0E:C6:A1:B2:C3 mode=server ip=192.168.50.1 prefix=24 gateway= dns= ssid= signal= band= default=0 driver=asix product=AX88772B ip6= dhcpserver= leasetime= leaseexpiry= inet= $(cfg 1a2b3c4d-0000-4000-8000-000000000002 USB%20adapter%2000:0E:C6:A1:B2:C3 1 mac 192.168.50.1 24 '' '')"
eth1_uplink="RESULT kind=iface name=eth1 type=ethernet usb=1 mac=00:E0:4C:68:00:12 carrier=1 speed=1000 state=connected profile=Wired%20connection%202 mode=client ip=10.0.0.57 prefix=24 gateway=10.0.0.1 dns=10.0.0.1 ssid= signal= band= default=1 driver=r8152 product=USB%2010/100/1000%20LAN ip6= dhcpserver=10.0.0.1 leasetime=3600 leaseexpiry= inet=yes $W2"
eth1_dead="RESULT kind=iface name=eth1 type=ethernet usb=1 mac=00:E0:4C:69:B1:0E carrier=1 speed=1000 state=connected profile=Wired%20connection%202 mode=client ip=192.168.20.164 prefix=24 gateway=192.168.20.1 dns=192.168.20.1 ssid= signal= band= default=1 driver=r8152 product=USB%2010/100/1000%20LAN ip6= dhcpserver=192.168.20.1 leasetime=43200 leaseexpiry= inet=no $W2"
eth2_nocable="RESULT kind=iface name=eth2 type=ethernet usb=1 mac=00:0E:C6:11:22:33 carrier=0 speed= state=unavailable profile= mode=client ip= prefix= gateway= dns= ssid= signal= band= default=0 driver=ax88179_178a product=AX88179 ip6= dhcpserver= leasetime= leaseexpiry= inet= $(cfg 5e6f7a8b-0000-4000-8000-000000000003 USB%20adapter%2000:0E:C6:11:22:33 1 mac '' '' '' '')"

sum() { # <internet> <via> <defaultdev> <wifi> <country>
    echo "RESULT kind=summary internet=$1 via=$2 defaultdev=$3 connectivity=full wifi=$4 country=$5 volatile=1 wifiboot=on"
}

# the DHCP guard took the serving adapter down (another server answered), or is checking
eth1_stopped=$(printf '%s' "$eth1_serving" | sed 's/ carrier=1 / carrier=1 /; s/ state=connected / state=disconnected /; s/ ip=192.168.50.1 prefix=24 / ip= prefix= /')" guard=stopped guardserver=192.168.1.1 guardtime=1791259200"
eth1_checking="$eth1_serving guard=checking guardserver= guardtime="
status() {
    case $scenario in
        offline)
            echo "$eth0_nocable"; echo "$wlan_idle"; sum no '' '' on DE ;;
        usb-adapter)
            echo "$eth0_lan"; echo "$wlan_idle"; echo "$eth1_uplink"; echo "$eth2_nocable"; sum yes eth1 eth1 on DE ;;
        dead-uplink)
            echo "$eth1_dead"; echo "$eth0_up2"; echo "$wlan_idle"; sum yes eth0 eth1 on DE ;;
        wifi-blocked)
            echo "$eth0_up"; echo "$wlan_off"; sum yes eth0 eth0 off DE ;;
        wifi-absent)
            echo "$eth0_up"; sum yes eth0 eth0 absent '' ;;
        wifi-default)
            echo "$eth0_nocable"; echo "$wlan_default"; sum yes wlan0 wlan0 on DE ;;
        wired-static|probe-found|probe-none)
            echo "$eth0_static"; echo "$wlan_on"; echo "$eth2_nocable"; sum yes eth0 eth0 on DE ;;
        probe-no-cable)
            echo "$eth0_nocable"; echo "$wlan_default"; echo "$eth1_serving"; sum yes wlan0 wlan0 on DE ;;
        legacy-server)
            echo "$eth0_legacy"; echo "$wlan_default"; sum yes wlan0 wlan0 on DE ;;
        guard-stopped)
            echo "$eth0_up"; echo "$wlan_on"; echo "$eth1_stopped"; sum yes eth0 eth0 on DE ;;
        guard-checking)
            echo "$eth0_up"; echo "$wlan_on"; echo "$eth1_checking"; sum yes eth0 eth0 on DE ;;
        *)
            echo "$eth0_up"; echo "$wlan_on"
            case $scenario in online-serving|wired-fail|reserved|reserve-fail) echo "$eth1_serving" ;; esac
            sum yes eth0 eth0 on DE ;;
    esac
}

scan() {
    active_workshop=1
    case $scenario in offline|usb-adapter|dead-uplink) active_workshop=0 ;; esac
    echo "RESULT kind=ap ssid=Workshop signal=71 security=wpa2 band=5 saved=1 active=$active_workshop"
    echo "RESULT kind=ap ssid=FRITZ%21Box%207590%20HR signal=64 security=wpa2 band=2.4 saved=0 active=0"
    echo "RESULT kind=ap ssid=Lab-Bench signal=58 security=wpa3 band=5 saved=1 active=0"
    echo "RESULT kind=ap ssid=Caf%C3%A9%20%22Am%20Markt%22 signal=52 security=open band=2.4 saved=0 active=0"
    echo "RESULT kind=ap ssid=softliQ:MC_ab0f32 signal=47 security=wpa2 band=2.4 saved=0 active=0"
    echo "RESULT kind=ap ssid=Corp%20Wireless signal=41 security=enterprise band=5 saved=0 active=0"
    echo "RESULT kind=ap ssid=Guest%20%3D%20100%25 signal=33 security=wpa2 band=2.4 saved=0 active=0"
    echo "RESULT kind=ap ssid=WLAN1-L428T0 signal=21 security=wpa2 band=2.4 saved=0 active=0"
    echo "RESULT kind=saved ssid=Workshop uuid=11111111-2222-3333-4444-555555555555 autoconnect=1 active=$active_workshop hidden=0 inrange=1"
    echo "RESULT kind=saved ssid=Lab-Bench uuid=22222222-2222-3333-4444-555555555555 autoconnect=0 active=0 hidden=0 inrange=1"
    echo "RESULT kind=saved ssid=Home%20Office uuid=33333333-2222-3333-4444-555555555555 autoconnect=1 active=0 hidden=0 inrange=0"
}

ssid='' iface='' mode=''
for a in "$@"; do
    case $a in
        --ssid=*) ssid=${a#--ssid=} ;;
        --iface=*) iface=${a#--iface=} ;;
        --mode=*) mode=${a#--mode=} ;;
        --target=*) target=${a#--target=} ;;
        --host=*) host=${a#--host=} ;;
        --secs=*) secs=${a#--secs=} ;;
        --udp) udp=1 ;;
        --reverse) reverse=1 ;;
        --stop) stop=1 ;;
    esac
done
tool=${FAKE_TOOL:-ok}
tstep=${FAKE_TOOL_STEP:-0.15}

# one interval line a step, a curve that settles
iperf_run() { # <seconds> <base Mbit/s>
    n=1
    while [ "$n" -le "$1" ]; do
        sleep "$tstep"
        echo "RESULT kind=iperf interval=$((n - 1)).00-$n.00 mbit=$(awk -v b="$2" -v n="$n" 'BEGIN { printf "%.1f", b * (1 - 0.35 / n) + (n % 3) * b * 0.02 }')"
        n=$((n + 1))
    done
}

case $cmd in
    available) echo "RESULT kind=available ok=1" ;;
    status) status ;;
    monitor)
        echo "NOTICE changed"
        while :; do sleep 3600; done ;;
    leases)
        echo "RESULT kind=lease ip=192.168.50.23 mac=B8:27:EB:01:02:03 host=pi-bench-2 expires=1791262000"
        echo "RESULT kind=lease ip=192.168.50.61 mac=3C:22:FB:AA:BB:CC host=laptop expires=1791262500"
        echo "RESULT kind=lease ip=192.168.50.88 mac=DC:A6:32:44:55:66 host= expires=1791263100"
        case $scenario in reserved|reserve-fail)
            echo "RESULT kind=reservation mac=B8:27:EB:01:02:03 ip=192.168.50.23"
            echo "RESULT kind=reservation mac=3C:22:FB:AA:BB:CC ip=192.168.50.5"
            echo "RESULT kind=reservation mac=48:B0:2D:87:68:8D ip=192.168.50.2" ;;
        esac
        echo "RESULT kind=leases iface=$iface count=3" ;;
    dhcp-reserve)
        echo "NOTICE detached"
        sleep "$step"
        m=''; ip=''; forget=0
        for a in "$@"; do case $a in --mac=*) m=${a#--mac=} ;; --ip=*) ip=${a#--ip=} ;; --forget) forget=1 ;; esac; done
        m=$(printf '%s' "$m" | tr 'a-f' 'A-F')
        if [ "$scenario" = reserve-fail ]; then
            echo "RESULT kind=reservation ok=0 detail=$ip%20is%20leased%20to%20DC:A6:32:44:55:66 reason=in-use"
            exit 1
        fi
        if [ "$forget" = 1 ]; then echo "RESULT kind=reservation iface=$iface mac=$m ip=192.168.50.5 action=removed"
        else echo "RESULT kind=reservation iface=$iface mac=$m ip=$ip action=added"; fi ;;
    dhcp-probe)
        sleep "$step"; sleep "$step"
        case $scenario in
            probe-found)
                echo "RESULT kind=offer iface=$iface server=192.168.1.1 offered=192.168.1.57 router=192.168.1.1"
                echo "RESULT kind=probe iface=$iface servers=1 carrier=1" ;;
            *) echo "RESULT kind=probe iface=$iface servers=0 carrier=1" ;;
        esac ;;
    wired-set)
        echo "NOTICE detached"
        sleep "$step"; echo "PROGRESS phase=activating"
        sleep "$step"; echo "PROGRESS phase=checking"
        sleep "$step"
        if [ "$scenario" = wired-fail ]; then
            echo "NOTICE restoring the previous settings"
            echo "RESULT kind=wired iface=$iface mode=$mode ok=0 restored=1 detail=the%20address,%20NetworkManager's%20dnsmasq%20or%20the%20drop-in%20is%20missing reason=check-failed"
            exit 3
        fi
        echo "RESULT kind=wired iface=$iface mode=$mode ok=1 ip=192.168.50.1" ;;
    wifi-scan)
        case $scenario in wifi-blocked|wifi-absent) exit 2 ;; esac
        scan ;;
    wifi-connect)
        # the password, if any, is the first line of stdin (never printed)
        IFS= read -r _pw || true
        reason=''
        case $scenario in
            connect-bad-password) reason=bad-password ;;
            connect-not-found) reason=not-found ;;
            connect-no-address) reason=no-address ;;
            connect-timeout) reason=timeout ;;
        esac
        if [ "$reason" = not-found ]; then
            echo "RESULT kind=connect ok=0 detail=no%20network%20named%20it%20is%20in%20range reason=not-found"; exit 2
        fi
        # as net-ctl.sh run as root with systemd-run does (Pi OS)
        echo "NOTICE detached"
        sleep "$step"; echo "PROGRESS phase=associating"
        sleep "$step"; echo "PROGRESS phase=authenticating"
        if [ "$reason" = bad-password ]; then
            sleep "$step"
            echo "RESULT kind=connect ssid=$ssid ok=0 restored=Workshop detail= reason=bad-password"; exit 3
        fi
        sleep "$step"; echo "PROGRESS phase=address"
        if [ -n "$reason" ]; then
            sleep "$step"
            echo "RESULT kind=connect ssid=$ssid ok=0 restored=Workshop detail= reason=$reason"; exit 3
        fi
        sleep "$step"
        echo "RESULT kind=connect ssid=$ssid ok=1 ip=192.168.20.141" ;;
    wifi-disconnect) echo "RESULT kind=disconnect ok=1" ;;
    wifi-forget) echo "RESULT kind=forget ssid=$ssid ok=1" ;;
    wifi-autoconnect) echo "RESULT kind=autoconnect ssid=$ssid ok=1" ;;
    wifi-radio) sleep "$step"; echo "RESULT kind=radio ok=1" ;;
    dhcp-guard)
        # --retry: FAKE_TOOL=still -> the other server still answers
        echo "NOTICE detached"
        sleep "$step"; echo "NOTICE bringing $iface up; the guard probes before it serves"
        sleep "$step"; sleep "$step"
        if [ "$tool" = still ]; then echo "RESULT kind=guard iface=$iface action=stopped server=192.168.1.1"; exit 2; fi
        echo "RESULT kind=guard iface=$iface action=serving" ;;
    ping)
        case $tool in
            unknown-host) echo "RESULT kind=ping target=$target sent=0 received=0 avg= loss=100 reason=unknown-host"; exit 2 ;;
        esac
        n=1 got=0
        while [ $n -le 10 ]; do
            sleep "$tstep"
            if [ "$tool" = no-reply ] || { [ "$tool" = loss ] && { [ $n = 3 ] || [ $n = 7 ] || [ $n = 8 ]; }; }; then
                echo "RESULT kind=lost seq=$n"
            else
                echo "RESULT kind=reply seq=$n ms=0.$((300 + n * 37 % 200)) from=$target"; got=$((got + 1))
            fi
            n=$((n + 1))
        done
        echo "RESULT kind=ping target=$target sent=10 received=$got avg=$( [ $got -gt 0 ] && echo 0.412) loss=$(( (10 - got) * 10 ))"
        [ $got -gt 0 ] || exit 2 ;;
    internet-check)
        dev=${iface:-eth0}
        sleep "$tstep"; sleep "$tstep"
        if [ "$tool" = gateway-fail ]; then
            echo "RESULT kind=check step=gateway ok=0 target=192.168.1.1 reason=no-reply"
        else
            echo "RESULT kind=check step=gateway ok=1 ms=0.31 target=192.168.1.1"
        fi
        sleep "$tstep"; sleep "$tstep"
        if [ "$tool" = dns-fail ]; then
            echo "RESULT kind=check step=dns ok=0 server=192.168.1.1 name=www.google.com bound=1 reason=servfail"
        else
            echo "RESULT kind=check step=dns ok=1 ms=11.4 server=192.168.1.1 name=www.google.com addr=142.251.151.119 bound=1"
        fi
        sleep "$tstep"; sleep "$tstep"; sleep "$tstep"
        case $tool in
            dns-fail) echo "RESULT kind=check step=https ok=0 url=https://www.google.com/generate_204 bound=1 reason=timeout" ;;
            captive) echo "RESULT kind=check step=https ok=0 url=https://www.google.com/generate_204 bound=1 reason=http-302" ;;
            tls) echo "RESULT kind=check step=https ok=0 url=https://www.google.com/generate_204 bound=1 reason=tls" ;;
            *) echo "RESULT kind=check step=https ok=1 ms=141 code=204 url=https://www.google.com/generate_204 bound=1" ;;
        esac
        case $tool in dns-fail|captive|tls) echo "RESULT kind=internet iface=$dev ok=0"; exit 2 ;; esac
        echo "RESULT kind=internet iface=$dev ok=1" ;;
    iperf-server)
        [ "${stop:-0}" = 1 ] && { echo "RESULT kind=iperf-server running=0"; exit 0; }
        if [ "$tool" = port-busy ]; then echo "RESULT kind=iperf-server running=0 port=5201 reason=port-busy"; exit 2; fi
        echo "RESULT kind=iperf-server running=1 port=5201 addrs=192.168.1.170,192.168.50.1"
        if [ "$tool" = busy ]; then
            sleep "$tstep"; echo "RESULT kind=iperf-peer from=192.168.50.23"
            iperf_run 6 912
            echo "RESULT kind=iperf-sum role=receiver interval=0.00-10.00 mbit=905.0"
            sleep "$tstep"; echo "RESULT kind=iperf-peer from=192.168.50.61"
            iperf_run 5 431
        fi
        while :; do sleep 3600; done ;;
    iperf-client)
        echo "RESULT kind=iperf-client host=$host secs=${secs:-10} udp=${udp:-0} reverse=${reverse:-0}"
        case $tool in
            refused|unreachable) sleep "$tstep"; echo "RESULT kind=iperf-done ok=0 host=$host reason=$tool"; exit 2 ;;
        esac
        if [ "${udp:-0}" = 1 ]; then
            iperf_run "${secs:-10}" 100
            echo "RESULT kind=iperf-sum role=sender interval=0.00-${secs:-10}.00 mbit=100.0 jitter=0.000 lost=0 packets=8634"
            echo "RESULT kind=iperf-sum role=receiver interval=0.00-${secs:-10}.00 mbit=98.7 jitter=0.042 lost=112 packets=8634"
        else
            iperf_run "${secs:-10}" 941
            echo "RESULT kind=iperf-sum role=sender interval=0.00-${secs:-10}.00 mbit=936.0 retr=12"
            echo "RESULT kind=iperf-sum role=receiver interval=0.00-${secs:-10}.00 mbit=933.0"
        fi
        echo "RESULT kind=iperf-done ok=1 host=$host" ;;
    *) echo "fake-net-ctl: unknown command $cmd" >&2; exit 1 ;;
esac
exit 0
