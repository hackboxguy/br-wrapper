#!/bin/sh
# fake-nmcli - stands in for nmcli under tests/test_net_ctl.sh.
#
# Every call is recorded, one line per call, arguments joined by "|", in
# $FAKE_NM/calls. What a call reads on stdin (the passwd-file of
# "connection up") goes to $FAKE_NM/stdin - never into the calls log, which
# is exactly what the test checks.
#
# State lives in $FAKE_NM:
#   profiles   uuid<TAB>ssid<TAB>autoconnect(yes|no)<TAB>active(yes|no)  WiFi profiles
#   eth        wired profiles, "|"-separated: uuid|name|method|addresses|gateway|dns|
#              ifname|mac|autoconnect|priority|timestamp|file|active-device|never-default|ipv6
#   addrs      "dev a.b.c.d/n" per address (read by the fake ip)
#   mode       how a WiFi activation goes: ok | bad-password | no-address | timeout
#   wiredmode  how a wired activation goes: ok | fail (the first one fails, the
#              restore succeeds) | nodnsmasq (up, but no dnsmasq appears)
#   radio      enabled | disabled
#   running    running | (anything else: NetworkManager down)
#   down       created by "connection down": ends a looping activation
d=${FAKE_NM:?FAKE_NM is not set}
joined=$(for a in "$@"; do printf '%s|' "$a"; done)
# one write per call: the monitor and the activation run at the same time
printf '%s\n' "$joined" >> "$d/calls"
mode=$(cat "$d/mode" 2>/dev/null || echo ok)
wmode=$(cat "$d/wiredmode" 2>/dev/null || echo ok)
tab=$(printf '\t')
touch "$d/eth" "$d/profiles" "$d/addrs"

has() { case "|$joined" in *"|$1|"*) return 0 ;; esac; return 1; }

eth_field() { # <uuid> <column 1-15>
    awk -F '|' -v u="$1" -v c="$2" '$1 == u { print $c; exit }' "$d/eth"
}
eth_set() { # <uuid> <column> <value>
    awk -F '|' -v OFS='|' -v u="$1" -v c="$2" -v v="$3" '$1 == u { $c = v } 1' "$d/eth" > "$d/.e" && mv "$d/.e" "$d/eth"
}
col_of() { # nmcli setting -> eth column
    case $1 in
        connection.id) echo 2 ;; ipv4.method) echo 3 ;; ipv4.addresses) echo 4 ;; ipv4.gateway) echo 5 ;;
        ipv4.dns) echo 6 ;; connection.interface-name) echo 7 ;; 802-3-ethernet.mac-address) echo 8 ;;
        connection.autoconnect) echo 9 ;; connection.autoconnect-priority) echo 10 ;;
        connection.timestamp) echo 11 ;; ipv4.never-default) echo 14 ;; ipv6.method) echo 15 ;;
        *) echo 0 ;;
    esac
}
apply_settings() { # <uuid> <key> <value> ...
    u=$1; shift
    while [ $# -ge 2 ]; do
        c=$(col_of "$1")
        [ "$c" != 0 ] && eth_set "$u" "$c" "$2"
        shift 2
    done
}

case $joined in
    "-t|-f|RUNNING|general|") cat "$d/running" 2>/dev/null || echo running ;;
    "-t|-f|CONNECTIVITY|general|") echo full ;;
    "-t|-f|WIFI|radio|") cat "$d/radio" 2>/dev/null || echo enabled ;;
    "-t|-e|yes|-f|DEVICE,TYPE|device|")
        # NetworkManager 1.42 lists a veth as "ethernet" (seen on the rig)
        printf 'eth0:ethernet\neth1:ethernet\nwlan0:wifi\np2p-dev-wlan0:wifi-p2p\nlo:loopback\nvethnm:ethernet\ndocker0:bridge\n' ;;
    "-t|-e|yes|-f|DEVICE,UUID|connection|show|--active|")
        awk -F '|' '$13 != "" { print $13 ":" $1 }' "$d/eth"
        awk -F "$tab" '$4 == "yes" { print "wlan0:" $1 }' "$d/profiles" ;;
    "-t|-e|yes|-f|UUID,TYPE,FILENAME|connection|show|")
        awk -F '|' '{ f = $12; gsub(/:/, "\\:", f); print $1 ":802-3-ethernet:" f }' "$d/eth"
        awk -F "$tab" '{ print $1 ":802-11-wireless:/etc/NetworkManager/system-connections/" $2 ".nmconnection" }' "$d/profiles"
        echo "lo-uuid:loopback:/run/NetworkManager/system-connections/lo.nmconnection" ;;
    "-t|-f|connection.id,ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns,connection.interface-name,802-3-ethernet.mac-address,connection.autoconnect,connection.autoconnect-priority,connection.timestamp|connection|show|uuid|"*)
        awk -F '|' -v u="$7" '$1 == u {
            print "connection.id:" $2; print "ipv4.method:" $3; print "ipv4.addresses:" $4; print "ipv4.gateway:" $5
            print "ipv4.dns:" $6; print "connection.interface-name:" $7; print "802-3-ethernet.mac-address:" $8
            print "connection.autoconnect:" $9; print "connection.autoconnect-priority:" $10; print "connection.timestamp:" $11 }' "$d/eth" ;;
    "-t|-f|ipv4.method|connection|show|uuid|"*|"-t|-f|ipv4.addresses|connection|show|uuid|"*|"-t|-f|ipv4.gateway|connection|show|uuid|"*|"-t|-f|ipv4.dns|connection|show|uuid|"*|"-t|-f|ipv4.never-default|connection|show|uuid|"*|"-t|-f|ipv6.method|connection|show|uuid|"*|"-t|-f|802-3-ethernet.mac-address|connection|show|uuid|"*|"-t|-f|connection.interface-name|connection|show|uuid|"*)
        echo "$3:$(eth_field "$7" "$(col_of "$3")")" ;;
    "-t|-f|GENERAL,IP4,DHCP4,IP6|device|show|eth0|")
        cat <<'EOF'
GENERAL.DEVICE:eth0
GENERAL.TYPE:ethernet
GENERAL.HWADDR:2C:CF:67:4F:66:CA
GENERAL.STATE:100 (connected)
GENERAL.CONNECTION:Wired connection 1
IP4.ADDRESS[1]:192.168.1.170/24
IP4.GATEWAY:192.168.1.1
IP4.DNS[1]:192.168.1.1
IP4.DNS[2]:9.9.9.9
DHCP4.OPTION[1]:dhcp_lease_time = 86400
DHCP4.OPTION[2]:dhcp_server_identifier = 192.168.1.1
IP6.ADDRESS[1]:fe80::76f9:b550:2848:fea0/64
EOF
        ;;
    "-t|-f|GENERAL,IP4,DHCP4,IP6|device|show|"*)
        printf 'GENERAL.DEVICE:%s\nGENERAL.HWADDR:%s\nGENERAL.STATE:30 (disconnected)\nGENERAL.CONNECTION:\n' \
            "$6" "$(tr 'a-f' 'A-F' < "${NET_CTL_SYSFS:-/nonexistent}/$6/address" 2>/dev/null)" ;;
    "-t|-f|IP4.ADDRESS|device|show|wlan0|") echo "IP4.ADDRESS[1]:192.168.20.138/24" ;;
    "-t|-e|yes|-f|ACTIVE,SSID,SIGNAL,FREQ|device|wifi|list|ifname|wlan0|--rescan|no|") echo "no:Workshop:71:5180 MHz" ;;
    "-t|-e|yes|-f|IN-USE,SSID,SIGNAL,SECURITY,FREQ|device|wifi|list|--rescan|"*)
        # two BSSIDs of one network (the stronger wins), an escaped colon,
        # an enterprise network, OWE, a hidden one (empty SSID)
        printf ' :Workshop:40:WPA2:2412 MHz\n'
        printf ' :Workshop:71:WPA2:5180 MHz\n'
        printf ' :Caf\303\251 Am Markt:52::2437 MHz\n'
        printf ' :softliQ\\:MC_ab0f32:47:WPA1 WPA2:2412 MHz\n'
        printf ' :Lab-Bench:58:WPA3:5500 MHz\n'
        printf ' :Corp:41:WPA2 802.1X:5200 MHz\n'
        printf ' :Enhanced Open:44:OWE:5240 MHz\n'
        printf ' ::30:WPA2:2462 MHz\n' ;;
    "-t|-e|yes|-f|UUID,TYPE,AUTOCONNECT,ACTIVE|connection|show|")
        awk -F '|' '{ print $1 ":802-3-ethernet:" $9 ":" ($13 != "" ? "yes" : "no") }' "$d/eth"
        awk -F "$tab" '{ print $1 ":802-11-wireless:" $3 ":" $4 }' "$d/profiles" ;;
    "-t|-f|802-11-wireless.ssid,802-11-wireless.hidden|connection|show|uuid|"*|"-t|-f|802-11-wireless.ssid|connection|show|uuid|"*)
        u=$7
        awk -F "$tab" -v u="$u" '$1 == u { print "802-11-wireless.ssid:" $2; print "802-11-wireless.hidden:no" }' "$d/profiles" ;;
    "connection|add|type|ethernet|"*)
        # connection add type ethernet con-name N ifname IF connection.autoconnect yes <settings...>
        name=$6
        n=$(( $(wc -l < "$d/eth") + 1 ))
        u="cccccccc-0000-0000-0000-00000000000$n"
        printf '%s|%s||||||||0|0|/etc/NetworkManager/system-connections/%s.nmconnection|||\n' "$u" "$name" "$name" >> "$d/eth"
        eth_set "$u" 7 "$8"
        shift 8
        apply_settings "$u" "$@"
        echo "Connection '$name' ($u) successfully added." ;;
    "connection|add|"*)
        name=$6
        n=$(( $(wc -l < "$d/profiles") + 1 ))
        u="bbbbbbbb-0000-0000-0000-00000000000$n"
        printf '%s\t%s\tyes\tno\n' "$u" "$name" >> "$d/profiles"
        echo "Connection '$name' ($u) successfully added." ;;
    "connection|modify|uuid|"*)
        u=$4
        if grep -q "^$u|" "$d/eth"; then
            shift 4
            apply_settings "$u" "$@"
            # a modified in-memory profile is written to disk (as on the rig)
            eth_set "$u" 12 "/etc/NetworkManager/system-connections/$(eth_field "$u" 2).nmconnection"
        fi
        echo "modified" ;;
    "connection|delete|uuid|"*)
        awk -F "$tab" -v u="$4" '$1 != u' "$d/profiles" > "$d/.p" && mv "$d/.p" "$d/profiles"
        awk -F '|' -v u="$4" '$1 != u' "$d/eth" > "$d/.e" && mv "$d/.e" "$d/eth"
        echo "Connection deleted." ;;
    "connection|down|uuid|"*)
        : > "$d/down"
        awk -F "$tab" -v OFS="$tab" -v u="$4" '$1 == u { $4 = "no" } 1' "$d/profiles" > "$d/.p" && mv "$d/.p" "$d/profiles" ;;
    "device|disconnect|"*) echo "Device '$3' successfully disconnected." ;;
    "radio|wifi|on|") echo enabled > "$d/radio" ;;
    "radio|wifi|off|") echo disabled > "$d/radio" ;;
    "monitor|") echo "NetworkManager is running"; exec sleep 30 ;;
    "device|monitor|"*)
        echo "$3: using connection"
        echo "$3: connecting (prepare)"
        echo "$3: connecting (configuring)"
        echo "$3: connecting (need authentication)"   # the key fetch, every time
        echo "$3: connecting (prepare)"
        echo "$3: connecting (configuring)"
        case $mode in
            bad-password) echo "$3: connecting (need authentication)" ;;
            ok|no-address) echo "$3: connecting (getting IP configuration)" ;;
        esac
        [ "$mode" = ok ] && echo "$3: connected"
        exec sleep 30 ;;
    "--wait|"*"|connection|up|uuid|"*"|ifname|"*)
        # a wired activation: --wait N connection up uuid U ifname IF
        u=$6 dev=$8
        if [ "$wmode" = fail ] && [ ! -f "$d/wired-upped" ]; then
            : > "$d/wired-upped"
            echo "Error: Connection activation failed: IP configuration could not be reserved"
            exit 4
        fi
        : > "$d/wired-upped"
        awk -v dv="$dev" '$1 != dv' "$d/addrs" > "$d/.a" && mv "$d/.a" "$d/addrs"
        rm -f "$d/dnsmasq"
        m=$(eth_field "$u" 3); a=$(eth_field "$u" 4)
        case $m in
            auto) echo "$dev 192.168.1.77/24" >> "$d/addrs" ;;
            manual) echo "$dev $a" >> "$d/addrs" ;;
            shared)
                echo "$dev $a" >> "$d/addrs"
                [ "$wmode" = nodnsmasq ] || echo "4242 /usr/sbin/dnsmasq --conf-file=/dev/null --no-hosts --bind-interfaces --listen-address=${a%/*} --dhcp-range=${a%.*}.10,${a%.*}.254,60m --conf-dir=${NET_CTL_SHARED_DIR}" > "$d/dnsmasq" ;;
        esac
        awk -F '|' -v OFS='|' -v u="$u" -v dv="$dev" '$13 == dv { $13 = "" } $1 == u { $13 = dv } 1' "$d/eth" > "$d/.e" \
            && mv "$d/.e" "$d/eth"
        echo "Connection successfully activated"
        exit 0 ;;
    "--wait|"*"|connection|up|uuid|"*)
        u=$6
        if has "passwd-file"; then cat > "$d/stdin"; fi
        rm -f "$d/down"
        sleep 0.3
        # only the first activation goes the mode's way: the restore of the
        # previous connection after it succeeds
        [ -f "$d/upped" ] && mode=ok
        : > "$d/upped"
        case $mode in
            ok)
                awk -F "$tab" -v OFS="$tab" -v u="$u" '{ $4 = ($1 == u) ? "yes" : "no" } 1' "$d/profiles" > "$d/.p" \
                    && mv "$d/.p" "$d/profiles"
                echo "Connection successfully activated (D-Bus active path: /org/freedesktop/NetworkManager/ActiveConnection/9)"
                exit 0 ;;
            bad-password)
                # loops on the refused key until "connection down"
                i=0
                while [ ! -f "$d/down" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
                echo "Error: Connection activation failed: The base network connection was interrupted"
                exit 4 ;;
            no-address)
                echo "Error: Connection activation failed: IP configuration could not be reserved (no available address, timeout, etc.)."
                exit 4 ;;
            timeout)
                echo "Error: Timeout expired (60 seconds)"
                exit 3 ;;
        esac ;;
    *) echo "fake-nmcli: unhandled: $joined" >&2; exit 2 ;;
esac
exit 0
